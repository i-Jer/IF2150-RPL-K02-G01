{
  "appId": "id.seaguard.app",
  "appName": "SeaGuard",
  "webDir": "dist",
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#eef2f4"
  },
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "CapacitorUpdater": {
      "autoUpdate": false,
      "resetWhenUpdate": true,
      "appReadyTimeout": 15000
    },
    "SystemBars": {
      "style": "LIGHT"
    }
  }
}
