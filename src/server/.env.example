# Copy to .env (git-ignored) for local runs. Railway sets these as service variables in production.

# PostgreSQL + PostGIS. This matches docker-compose.yml in src/.
DATABASE_URL=postgres://seaguard:seaguard@localhost:5432/seaguard

# Port for the API and the built web app.
PORT=8080

# Secret used to sign session tokens. Use a long random value outside local development.
JWT_SECRET=change-me-to-a-long-random-string

# Public URL of this server (used for links in the Android update manifest). Empty is fine locally.
PUBLIC_URL=

# Photo storage. Leave empty to store photos in server/uploads/ (local). Set all five for an S3-compatible bucket.
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Password for the seeded admin account (admin@seaguard.test). Demo volunteer/verifier passwords are in README section 4.
SEED_ADMIN_PASSWORD=change-me
