{
  "name": "seaguard-server",
  "version": "1.0.0",
  "private": true,
  "description": "SeaGuard API server (Express, MVC) with PostgreSQL + PostGIS and S3 object storage",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seed.js",
    "test": "node --test tests/e2e.test.mjs",
    "profile": "node tests/profile-heatmap.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1164.0",
    "@aws-sdk/s3-request-presigner": "^3.1164.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "exifr": "^7.1.3",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "multer": "^2.5.0",
    "pg": "^8.23.1"
  }
}
